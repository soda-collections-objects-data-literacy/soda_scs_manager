{
  "private": true,
  "name": "soda_scs_manager",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production postcss pcss/soda_scs_manager.pcss -o css/soda-scs-manager.css --config postcss.config.js",
    "build:dev": "postcss pcss/soda_scs_manager.pcss -o css/soda-scs-manager.css --map --config postcss.config.js",
    "watch": "postcss pcss/soda_scs_manager.pcss -o css/soda-scs-manager.css --map --watch --config postcss.config.js",
    "clean": "rm -f css/soda-scs-manager.css css/soda-scs-manager.css.map"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "@tailwindcss/postcss": "^4.3.1",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.10.38",
    "cssnano": "^8.0.2",
    "postcss": "^8.5.15",
    "postcss-cli": "^11.0.1"
  },
  "overrides": {
    "picomatch": ">=4.0.4"
  }
}
