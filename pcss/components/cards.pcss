/* Card Components */
/* These styles define card layout components */

@layer components {
  a {
    &.soda-scs-manager--tile-card {
      @apply box-border rounded-none p-6 flex flex-col items-center text-center border-0 bg-transparent;
      @apply no-underline transition-colors duration-200;
      /* Sammlungen .card: 2px black, radius 0; frame ::after + dot ::before in pcss/manager/unlayered/site-overrides.pcss */

      &::after {
        content: '';
        position: absolute;
        inset: 0;
        box-sizing: border-box;
        border: 2px solid #000;
        border-top-color: #000;
        border-right-color: #000;
        border-bottom-color: #000;
        border-left-color: #000;
        border-radius: 0;
        background: transparent;
        pointer-events: none;
        z-index: 3;
        transition: border-color 0.2s ease-in-out;
      }

      &:hover::after {
        border-color: #e68500;
      }

      h2 {
        @apply relative z-[2] bg-white text-xl font-semibold text-[#e68500] underline underline-offset-2 mt-4 mb-2;
      }

      p {
        @apply relative z-[2] bg-white text-stone-900;
      }
    }
  }

  .soda-scs-manager--card-type {
    @apply w-full shrink-0 text-center;
  }

  .soda-scs-manager--type--card {
    @apply relative box-border flex h-full min-h-0 w-full flex-col items-stretch p-3 text-center sm:p-4 xl:p-4;
  }

  .soda-scs-manager--health-icon {
    @apply absolute top-2 left-2 w-8 h-8 rounded-full border border-stone-300 transition-all duration-200 ease-in-out;
    @apply bg-white;
    @apply shadow-sm;
    z-index: 55;

    &::before {
      content: '';
      @apply absolute;
      top: 50%;
      left: 50%;
      z-index: 1;
      transform: translate(-50%, -50%);
      width: 20px;
      height: 20px;
      background-size: contain;
      background-position: center;
      background-repeat: no-repeat;
    }

    &.soda-scs-manager--health-running::before {
      background-image: url('/modules/contrib/soda_scs_manager/assets/images/health-running.svg');
    }

    &.soda-scs-manager--health-stopped::before {
      background-image: url('/modules/contrib/soda_scs_manager/assets/images/health-stopped.svg');
    }

    &.soda-scs-manager--health-problem::before,
    &.soda-scs-manager--health-failure::before {
      background-image: url('/modules/contrib/soda_scs_manager/assets/images/health-failure.svg');
    }

    &.soda-scs-manager--health-unknown::before,
    &.soda-scs-manager--health-starting::before {
      background-image: url('/modules/contrib/soda_scs_manager/assets/images/health-starting.svg');
      animation: pulse 1.5s ease-in-out infinite;
    }
  }

  .application__health-status {
    @apply inline-flex items-center gap-1.5 text-xs font-medium;

    .application__health__icon {
      @apply inline-block h-2.5 w-2.5 rounded-full;
      background-color: currentColor;
    }

    &.application__health-status--running {
      @apply text-emerald-700;
    }

    &.application__health-status--stopped {
      @apply text-stone-500;
    }

    &.application__health-status--problem {
      @apply text-rose-700;
    }

    &.application__health-status--unknown {
      @apply text-amber-700;
    }

    &.application__health-status--starting {
      @apply text-amber-700;

      .application__health__icon {
        animation: pulse 1.5s ease-in-out infinite;
      }
    }
  }

  /*
   * Health speed-dial: actions slide out to the right of the status chip.
   * Open on :hover / :focus-within (pointer: fine) and .is-open (tap / keyboard).
   * Do not animate display; opacity + transform keep the hover bridge intact.
   */
  .soda-scs-manager--health-control {
    @apply absolute top-2 left-2 z-[56] flex items-center;
    gap: 0.375rem;
    /* Extra hit area so the pointer can travel from icon to actions. */
    padding: 0.25rem 0.5rem 0.25rem 0.25rem;
    margin: -0.25rem 0 0 -0.25rem;
  }

  .soda-scs-manager--health-control .soda-scs-manager--health-icon {
    @apply relative top-auto left-auto m-0 shrink-0 cursor-pointer border border-stone-300 p-0;
    appearance: none;
    background-color: #fff;

    &:focus:not(:focus-visible) {
      outline: none;
      box-shadow: none;
    }

    &:focus-visible {
      outline: none;
      box-shadow:
        0 0 0 2px #e68500,
        0 0 0 4px rgba(230, 133, 0, 0.28);
    }
  }

  .soda-scs-manager--health-actions {
    @apply flex items-center;
    gap: 0.375rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(-0.375rem) scale(0.92);
    transform-origin: left center;
    transition:
      opacity 160ms ease-out,
      transform 160ms ease-out,
      visibility 160ms ease-out;
  }

  .soda-scs-manager--health-control:hover .soda-scs-manager--health-actions,
  .soda-scs-manager--health-control:focus-within .soda-scs-manager--health-actions,
  .soda-scs-manager--health-control.is-open .soda-scs-manager--health-actions {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0) scale(1);
  }

  .soda-scs-manager--health-control.is-busy .soda-scs-manager--health-actions {
    pointer-events: none;
    opacity: 0.55;
  }

  .soda-scs-manager--health-action {
    @apply relative h-8 w-8 shrink-0 cursor-pointer rounded-full border border-stone-300 bg-white shadow-sm;
    appearance: none;
    padding: 0;
    z-index: 56;
    transition:
      background-color 0.2s ease-in-out,
      box-shadow 0.2s ease-in-out,
      border-color 0.2s ease-in-out,
      transform 0.16s ease-in-out,
      opacity 160ms ease-out;

    &:hover {
      @apply border-[#e68500] shadow-md;
    }

    &:focus-visible {
      outline: none;
      box-shadow:
        0 0 0 2px #e68500,
        0 0 0 4px rgba(230, 133, 0, 0.28);
    }

    &:active {
      transform: scale(0.92);
    }

    &::before {
      content: '';
      @apply absolute;
      top: 50%;
      left: 50%;
      width: 1.25rem;
      height: 1.25rem;
      transform: translate(-50%, -50%);
      background-color: #e68500;
      background-image: none;
      mask-size: contain;
      mask-repeat: no-repeat;
      mask-position: center;
      -webkit-mask-size: contain;
      -webkit-mask-repeat: no-repeat;
      -webkit-mask-position: center;
    }

    &:hover::before,
    &:focus-visible::before,
    &:active::before {
      background-color: #b86a00;
    }
  }

  .soda-scs-manager--health-action--start::before {
    background-color: #22c55e;
    mask-image: url('/modules/contrib/soda_scs_manager/assets/images/health-action-start-mask.svg');
    -webkit-mask-image: url('/modules/contrib/soda_scs_manager/assets/images/health-action-start-mask.svg');
  }

  .soda-scs-manager--health-action--start:hover::before,
  .soda-scs-manager--health-action--start:focus-visible::before,
  .soda-scs-manager--health-action--start:active::before {
    background-color: #16a34a;
  }

  .soda-scs-manager--health-action--stop::before {
    /* CSS square — SVG masks were stretching into a tall rounded bar. */
    width: 0.75rem;
    height: 0.75rem;
    min-width: 0.75rem;
    min-height: 0.75rem;
    aspect-ratio: 1;
    border-radius: 0.125rem;
    background-color: #ef4444;
    mask-image: none;
    -webkit-mask-image: none;
  }

  .soda-scs-manager--health-action--stop:hover::before,
  .soda-scs-manager--health-action--stop:focus-visible::before,
  .soda-scs-manager--health-action--stop:active::before {
    background-color: #dc2626;
  }

  .soda-scs-manager--health-action--restart::before {
    background-color: #f59e0b;
    mask-image: url('/modules/contrib/soda_scs_manager/assets/images/health-action-restart-mask.svg');
    -webkit-mask-image: url('/modules/contrib/soda_scs_manager/assets/images/health-action-restart-mask.svg');
  }

  .soda-scs-manager--health-action--restart:hover::before,
  .soda-scs-manager--health-action--restart:focus-visible::before,
  .soda-scs-manager--health-action--restart:active::before {
    background-color: #d97706;
  }

  .soda-scs-manager--health-action:nth-child(1) {
    transition-delay: 0ms, 0ms, 0ms, 0ms, 0ms;
  }

  .soda-scs-manager--health-action:nth-child(2) {
    transition-delay: 40ms, 40ms, 40ms, 0ms, 40ms;
  }

  /* Running: stop + restart. Stopped: start only. Other states: no actions. */
  .soda-scs-manager--health-control[data-health-state="running"] [data-lifecycle-action="start"],
  .soda-scs-manager--health-control[data-health-state="stopped"] [data-lifecycle-action="stop"],
  .soda-scs-manager--health-control[data-health-state="stopped"] [data-lifecycle-action="restart"],
  .soda-scs-manager--health-control[data-health-state="problem"] .soda-scs-manager--health-actions,
  .soda-scs-manager--health-control[data-health-state="unknown"] .soda-scs-manager--health-actions,
  .soda-scs-manager--health-control[data-health-state="starting"] .soda-scs-manager--health-actions,
  .soda-scs-manager--health-control[data-health-state="other"] .soda-scs-manager--health-actions {
    display: none;
  }

  .soda-scs-manager--health-control[data-health-state="problem"] .soda-scs-manager--health-icon,
  .soda-scs-manager--health-control[data-health-state="unknown"] .soda-scs-manager--health-icon,
  .soda-scs-manager--health-control[data-health-state="starting"] .soda-scs-manager--health-icon,
  .soda-scs-manager--health-control[data-health-state="other"] .soda-scs-manager--health-icon {
    cursor: default;
  }

  @media (hover: none) {
    .soda-scs-manager--health-control:hover .soda-scs-manager--health-actions {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateX(-0.375rem) scale(0.92);
    }

    .soda-scs-manager--health-control.is-open .soda-scs-manager--health-actions,
    .soda-scs-manager--health-control:focus-within .soda-scs-manager--health-actions {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateX(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .soda-scs-manager--health-actions,
    .soda-scs-manager--health-action {
      transition: opacity 80ms linear, visibility 80ms linear;
      transform: none;
    }

    .soda-scs-manager--health-control:hover .soda-scs-manager--health-actions,
    .soda-scs-manager--health-control:focus-within .soda-scs-manager--health-actions,
    .soda-scs-manager--health-control.is-open .soda-scs-manager--health-actions {
      transform: none;
    }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  a.soda-scs-manager--card-icon {
    @apply no-underline;
  }

  .soda-scs-manager--card-icon {
    @apply absolute top-2 w-8 h-8 rounded-full cursor-pointer;
    @apply bg-white;
    @apply border border-stone-300;
    @apply shadow-sm hover:shadow-md;
    @apply outline-none;
    z-index: 55;
    background-color: #fff !important;
    transition: background-color 0.2s ease-in-out, box-shadow 0.3s ease-in-out, border-color 0.4s ease-in-out, transform 0.2s ease-in-out;

    &:hover {
      @apply border-[#e68500];
      background-color: #fff;
    }

    &:focus-visible {
      @apply bg-white border-[#e68500];
      background-color: #fff;
    }

    &:active {
      @apply bg-white border-[#b86a00];
      background-color: #fff;
      transform: scale(0.92);
    }

    &::before {
      content: '';
      @apply absolute;
      top: 50%;
      left: 50%;
      z-index: 1;
      transform: translate(-50%, -50%);
      width: 20px;
      height: 20px;
      background-size: contain;
      background-position: center;
      background-repeat: no-repeat;
      transition: background-image 0.2s ease-in-out;
    }
  }

  /* Mask + background-color — same hover/focus/active as .soda-scs-manager--book-icon (darker orange, no image swap) */
  .soda-scs-manager--details-icon {
    @apply right-12;

    &::before {
      background-color: #e68500;
      background-image: none;
      mask-image: url('/modules/contrib/soda_scs_manager/assets/images/info-icon-mask.svg');
      mask-size: contain;
      mask-repeat: no-repeat;
      mask-position: center;
      -webkit-mask-image: url('/modules/contrib/soda_scs_manager/assets/images/info-icon-mask.svg');
      -webkit-mask-size: contain;
      -webkit-mask-repeat: no-repeat;
      -webkit-mask-position: center;
      transition: background-color 0.2s ease-in-out;
    }

    &:hover::before {
      background-color: #b86a00;
    }

    &:focus-visible::before,
    &:active::before {
      background-color: #b86a00;
    }
  }

  /* Book chip: mask + background-color (matches .soda-scs-manager--details-icon) */
  .soda-scs-manager--card-icon.soda-scs-manager--book-icon {
    @apply right-2;

    &::before {
      background-color: #e68500;
      background-image: none;
      mask-image: url('/modules/contrib/soda_scs_manager/assets/images/book-icon-mask.svg');
      mask-size: contain;
      mask-repeat: no-repeat;
      mask-position: center;
      -webkit-mask-image: url('/modules/contrib/soda_scs_manager/assets/images/book-icon-mask.svg');
      -webkit-mask-size: contain;
      -webkit-mask-repeat: no-repeat;
      -webkit-mask-position: center;
      transition: background-color 0.2s ease-in-out;
    }

    &:hover::before {
      background-color: #b86a00;
    }

    &:focus-visible::before,
    &:active::before {
      background-color: #b86a00;
    }
  }

  /* Sammlungen .card shell: unset bg, 2px black, radius 0; border drawn on ::after above dot */
  .soda-scs-manager--card-content-wrapper {
    @apply relative box-border flex min-h-0 w-full flex-1 flex-col items-stretch rounded-none border-0 bg-transparent p-3 text-center opacity-100 transition-all duration-300 ease-in-out overflow-visible sm:p-4 xl:p-4;
  }

  /* Status copy as a centered panel above grey overlay (::after z-40; banner z-[45]; icons z-55). */
  .soda-scs-manager--card-status-banner {
    pointer-events: none;
    @apply absolute left-1/2 top-1/2 z-[45] flex max-h-[min(22rem,calc(100%-2rem))] w-max min-w-0 flex-col items-stretch gap-2 overflow-y-auto text-center opacity-0 invisible;
    max-width: calc(100% - 1.25rem);
    transform: translate(-50%, -50%) scale(1);
  }

  .soda-scs-manager--card-content-wrapper.soda-scs-manager--card--not-running .soda-scs-manager--card-status-banner:not(:empty) {
    @apply visible rounded-sm border border-stone-200 bg-white px-3 py-3 opacity-100 shadow-md md:px-4 md:py-3.5;
  }

  /* Same ring spinner as .soda-scs-manager__throbber-overlay__spinner, smaller for dashboard card. */
  .soda-scs-manager--card-status-banner__throbber {
    @apply mb-1 box-border flex-shrink-0 self-center rounded-full border-[3px] border-orange-300 border-t-orange-500;
    width: 2.25rem;
    height: 2.25rem;
    @apply animate-spin;
  }

  @media (prefers-reduced-motion: reduce) {
    .soda-scs-manager--card-status-banner__throbber {
      animation: none;
      opacity: 0.85;
    }
  }

  /* Dark copy on white panel (also readable on stopped/offline if panel reused). */
  .soda-scs-manager--card-status-banner__primary {
    @apply max-w-full text-sm font-semibold leading-snug text-stone-900 md:text-base;
  }

  .soda-scs-manager--card-status-banner__secondary {
    @apply max-w-full text-xs font-normal leading-snug text-stone-800 md:text-sm;
  }

  .soda-scs-manager--card-status-banner__detail {
    @apply block font-medium text-stone-900;
  }

  .soda-scs-manager--card-status-banner a.soda-scs-manager--card-status-banner__mailto {
    pointer-events: auto;
    @apply font-medium text-[#b86a00] underline decoration-[#b86a00]/80 underline-offset-2 transition-colors;
  }

  .soda-scs-manager--card-status-banner a.soda-scs-manager--card-status-banner__mailto:hover {
    @apply text-[#8c5200] decoration-[#8c5200];
  }

  .soda-scs-manager--card-content-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    border: 2px solid #000;
    border-top-color: #000;
    border-right-color: #000;
    border-bottom-color: #000;
    border-left-color: #000;
    border-radius: 0;
    background: transparent;
    pointer-events: none;
    z-index: 3;
    @apply transition-all duration-300 ease-in-out;
  }

  .soda-scs-manager--card-content-wrapper:hover::after {
    border-color: #e68500;
  }

  .soda-scs-manager--card-content-wrapper.soda-scs-manager--card--not-running::after {
    background: rgba(120, 113, 108, 0.5);
    pointer-events: auto;
    z-index: 40;
  }

  /* Starting uses same grey wash as default not-running (JS/Twig keep class for semantics / future use). */
  .soda-scs-manager--card-content-wrapper.soda-scs-manager--card--not-running.soda-scs-manager--card--status-stopped::after {
    background: rgba(87, 83, 78, 0.55);
  }

  .soda-scs-manager--card-content-wrapper.soda-scs-manager--card--not-running.soda-scs-manager--card--status-problem::after,
  .soda-scs-manager--card-content-wrapper.soda-scs-manager--card--not-running.soda-scs-manager--card--status-offline::after {
    background: rgba(68, 64, 60, 0.62);
  }

  .soda-scs-manager--card-body {
    @apply relative z-[2] min-h-0 flex-1 overflow-y-auto bg-white;
  }

  /* Above .soda-scs-manager--card-link (z-20) so action buttons stay clickable. */
  .soda-scs-manager--card-actions {
    @apply relative z-[55] mt-3 flex w-full shrink-0 flex-col gap-2 bg-white;
  }

  a.soda-scs-manager--card-action-button,
  button.soda-scs-manager--card-action-button {
    @apply block w-full rounded-md border-2 border-[#e68500] bg-[#e68500] px-3 py-2 text-center text-sm font-semibold text-white no-underline transition-colors duration-150;
    pointer-events: auto;

    &:hover,
    &:focus-visible {
      @apply border-[#b86a00] bg-[#b86a00] text-white no-underline outline-none;
    }

    &:active {
      @apply border-[#8c5200] bg-[#8c5200];
    }
  }

  /* Normalize media area so cards align visually regardless of image proportions. */
  .soda-scs-manager--image-wrapper {
    @apply relative z-[2] flex aspect-[4/3] w-full shrink-0 items-center justify-center overflow-hidden bg-white;
  }

  .soda-scs-manager--card-img-top {
    @apply block h-full w-full max-h-full max-w-full object-contain object-center;
  }

  .soda-scs-manager--tag-filter-container {
    @apply w-full;
  }

  /* Dashboard page: high-contrast titles (match card accent; avoid low-contrast stone-200 on dark UIs) */
  .soda-scs-manager--dashboard-heading-filter {
    @apply m-1 my-1 p-1 text-center text-2xl font-bold text-black;
  }

  .soda-scs-manager--dashboard-heading-section {
    @apply mb-4 text-center text-3xl font-bold text-black;
  }

  /* "Your applications" + inline add (+); replaces former add-application card in the grid */
  .soda-scs-manager--dashboard-heading-with-add {
    @apply flex flex-wrap items-center justify-center gap-2 md:gap-3;
  }

  .soda-scs-manager--dashboard-heading-section--inline {
    @apply mb-0 text-center;
  }

  /* Circular (+) beside section headings: dashboard (button) and projects page title (link). */
  .soda-scs-manager--add-app-heading-button {
    @apply box-border inline-flex shrink-0 cursor-pointer items-center justify-center rounded-full border-2 border-stone-400 bg-transparent p-0 font-light text-stone-600;
    @apply h-10 w-10 md:h-11 md:w-11;
    @apply transition-all duration-200 ease-in-out;
    @apply hover:border-[#e68500] hover:text-[#e68500];
  }

  .soda-scs-manager--add-app-heading-button:active {
    transform: scale(0.92);
  }

  /* Link variant: match button (no body-link underline / visited purple). */
  a.soda-scs-manager--add-app-heading-button {
    @apply no-underline;
  }

  a.soda-scs-manager--add-app-heading-button:any-link {
    @apply text-stone-600;
  }

  a.soda-scs-manager--add-app-heading-button:visited {
    @apply border-stone-400 text-stone-600;
  }

  a.soda-scs-manager--add-app-heading-button:hover,
  a.soda-scs-manager--add-app-heading-button:visited:hover {
    @apply border-[#e68500] text-[#e68500];
  }

  /* Plus size: do not inherit a heading-sized font from the button. */
  .soda-scs-manager--add-app-heading-plus {
    position: relative;
    top: -1px;
    font-size: 20px;
    line-height: 1;
  }

  #clear-all-tags,
  .soda-scs-manager--clear-tag-filters {
    @apply mx-auto mt-5 flex cursor-pointer items-center justify-center gap-1.5 rounded-full border-2 border-stone-400 bg-white px-5 py-1.5 text-sm font-medium text-stone-800 shadow-sm transition-all;
    @apply hover:bg-stone-50 hover:text-stone-900 hover:shadow-md;
  }

  .soda-scs-manager--clear-tag-filters-wrapper {
    @apply flex justify-center;
  }

  .soda-scs-manager--tag-filter-button {
    @apply font-medium leading-tight shadow-sm transition-shadow hover:shadow-md;
  }

  .soda-scs-manager--tag-filter .soda-scs-manager--tag-filter-button[aria-pressed="true"] {
    box-shadow: inset 0 0 0 2px rgb(120 113 108 / 0.5);
  }

  .soda-scs-manager--tag-filter .soda-scs-manager--tag-remove {
    @apply ml-1 inline-block w-3 shrink-0 text-center text-base font-bold leading-none;
    visibility: hidden;
  }

  .soda-scs-manager--tag-filter .soda-scs-manager--tag-filter-button[aria-pressed="true"] .soda-scs-manager--tag-remove {
    visibility: visible;
  }

  .soda-scs-manager--card-tag.soda-scs-manager--tag-filter-button[aria-pressed="true"] {
    box-shadow: inset 0 0 0 1px rgb(120 113 108 / 0.45);
  }

  .soda-scs-manager--type--card.hidden-by-filter {
    @apply opacity-0 max-h-0 my-0 py-0 border-0 pointer-events-none;
  }

  .soda-scs-manager--empty-filter-message {
    @apply col-span-full text-center py-8 px-4;

    p {
      @apply text-stone-300 text-lg;
    }

    a {
      @apply text-[#e68500] hover:text-[#b86a00] underline transition-colors duration-200;
    }
  }

  .soda-scs-manager--card-title {
    @apply text-base font-semibold text-[#e68500] xl:text-lg;
  }

  .soda-scs-manager--card-text {
    @apply text-sm text-stone-800 xl:text-base;
  }

  /* Project Nextcloud card: Team Folder activity replaces the image/description. */
  .soda-scs-manager--type--card--feed .soda-scs-manager--card-body {
    @apply flex flex-col;
  }

  .soda-scs-manager--card-feed {
    @apply mt-2 flex min-h-0 flex-1 flex-col text-left;
  }

  .soda-scs-manager--card-feed-heading {
    @apply mb-2 text-xs font-semibold uppercase tracking-wide text-stone-700;
  }

  .soda-scs-manager--card-feed-message {
    @apply text-sm text-stone-700;
  }

  .soda-scs-manager--card-feed-message--error {
    @apply text-red-700;
  }

  .soda-scs-manager--card-feed-connect {
    @apply relative z-[55] flex flex-col gap-2;
  }

  .soda-scs-manager--card-feed-list {
    @apply m-0 flex min-h-0 flex-1 list-none flex-col gap-2 overflow-y-auto p-0;
  }

  .soda-scs-manager--card-feed-item {
    @apply relative z-[55] flex min-w-0 items-start gap-2 text-left;
  }

  .soda-scs-manager--card-feed-item-text {
    @apply min-w-0 flex-1;
  }

  .soda-scs-manager--card-feed-action {
    @apply mt-0.5 inline-block h-5 w-5 shrink-0;
    background-color: #e68500;
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: center;
    -webkit-mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center;
  }

  .soda-scs-manager--card-feed-action--created {
    mask-image: url('/modules/contrib/soda_scs_manager/assets/images/feed-action-created-mask.svg');
    -webkit-mask-image: url('/modules/contrib/soda_scs_manager/assets/images/feed-action-created-mask.svg');
  }

  .soda-scs-manager--card-feed-action--changed {
    mask-image: url('/modules/contrib/soda_scs_manager/assets/images/feed-action-changed-mask.svg');
    -webkit-mask-image: url('/modules/contrib/soda_scs_manager/assets/images/feed-action-changed-mask.svg');
  }

  .soda-scs-manager--card-feed-action--deleted {
    mask-image: url('/modules/contrib/soda_scs_manager/assets/images/feed-action-deleted-mask.svg');
    -webkit-mask-image: url('/modules/contrib/soda_scs_manager/assets/images/feed-action-deleted-mask.svg');
  }

  .soda-scs-manager--card-feed-action--restored {
    mask-image: url('/modules/contrib/soda_scs_manager/assets/images/feed-action-restored-mask.svg');
    -webkit-mask-image: url('/modules/contrib/soda_scs_manager/assets/images/feed-action-restored-mask.svg');
  }

  .soda-scs-manager--card-feed-action--renamed {
    mask-image: url('/modules/contrib/soda_scs_manager/assets/images/feed-action-renamed-mask.svg');
    -webkit-mask-image: url('/modules/contrib/soda_scs_manager/assets/images/feed-action-renamed-mask.svg');
  }

  .soda-scs-manager--card-feed-action--moved {
    mask-image: url('/modules/contrib/soda_scs_manager/assets/images/feed-action-moved-mask.svg');
    -webkit-mask-image: url('/modules/contrib/soda_scs_manager/assets/images/feed-action-moved-mask.svg');
  }

  a.soda-scs-manager--card-feed-link {
    @apply block min-w-0 truncate text-sm font-medium;
    pointer-events: auto;
  }

  .soda-scs-manager--card-feed-label {
    @apply block min-w-0 truncate text-sm font-medium text-stone-900;
  }

  .soda-scs-manager--card-feed-subtitle {
    @apply block truncate text-xs text-stone-500;
  }

  /* Add Application Card Styles */
  .soda-scs-manager--add-app-content {
    @apply border-dashed border-black hover:border-[#e68500];
    @apply cursor-pointer;
  }

  .soda-scs-manager--add-app-content .soda-scs-manager--add-app-button {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    @apply bg-transparent border-0 p-0 cursor-pointer z-10;
  }

  .soda-scs-manager--plus-icon-container {
    @apply transition-all duration-300;
  }

  .soda-scs-manager--plus-icon {
    @apply transition-all duration-300;
  }

  .soda-scs-manager--add-app-content:hover .soda-scs-manager--plus-icon {
    @apply text-[#e68500] scale-110;
  }

  /* Popup Modal Styles */
  .soda-scs-manager--add-app-popup {
    z-index: 9999;
    @apply transition-opacity duration-300;
  }

  .soda-scs-manager--add-app-popup.hidden {
    @apply opacity-0;
  }

  .soda-scs-manager--add-app-popup.flex {
    @apply opacity-100;
  }

  /* Add app popup: one column on mobile, three on wide */
  .soda-scs-manager--add-app-popup-inner {
    max-height: 90vh;
    @apply overflow-y-auto;
  }

  @media (max-width: 767px) {
    .soda-scs-manager--add-app-popup {
      @apply p-3;
    }

    .soda-scs-manager--add-app-popup-inner {
      @apply p-6 max-w-full;
    }

    .soda-scs-manager--add-app-popup h2 {
      @apply text-2xl mb-6;
    }

    .soda-scs-manager--add-app-popup .grid {
      @apply grid-cols-1 gap-4;
    }
  }

  /*
   * Claro / Gin: .page-wrapper *:focus applies a green (--color-focus) box-shadow.
   * Mouse click leaves :focus without :focus-visible — clear that ring.
   * Keyboard :focus-visible: SODa orange ring (same as card-icon / tag filters).
   */
  #add-app-popup .soda-scs-manager--add-app-popup-card:focus:not(:focus-visible),
  #add-app-popup .soda-scs-manager--add-app-popup-card:active {
    outline: none;
    box-shadow: none;
  }

  #add-app-popup .soda-scs-manager--add-app-popup-card:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px #e68500,
      0 0 0 4px rgba(230, 133, 0, 0.28);
  }
}
