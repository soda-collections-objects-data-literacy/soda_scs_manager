/**
 * @file
 * Conversation and inbox structure (layout only).
 *
 * Visual theming (colours, radii, type weight) lives in scs_custom_theme
 * assets/scss/content/_messages.scss.
 */

.scs-manager--conversation-start {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.scs-manager--conversation-start__chip {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.scs-manager--conversation-start__chip-remove {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.25rem;
  height: 1.25rem;
  padding: 0;
  border: 0;
  cursor: pointer;
  line-height: 1;
  font-size: 1rem;
}

.scs-manager--conversation-team__new {
  display: inline-flex;
  margin-bottom: 1rem;
}

.scs-manager--conversation-team__filters {
  margin-bottom: 1rem;
}

.scs-manager--message-actions-row .button {
  cursor: pointer;
}

.scs-manager--messages-conversation {
  display: flex;
  flex-direction: column;
  min-width: 0;
  text-decoration: none;
  color: inherit;
}

.scs-manager--messages-preview {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scs-manager--conversation-back,
.scs-manager--conversation-participant {
  margin-bottom: 0.75rem;
}

.scs-manager--conversation-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.scs-manager--conversation-message {
  display: flex;
  align-items: flex-end;
  gap: 0.5rem;
  align-self: flex-start;
  max-width: 48rem;
}

.scs-manager--conversation-message--own {
  flex-direction: row-reverse;
  align-self: flex-end;
}

.scs-manager--conversation-avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  width: 2.25rem;
  height: 2.25rem;
}

.scs-manager--conversation-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.scs-manager--conversation-bubble {
  min-width: 0;
}

.scs-manager--conversation-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0.5rem;
  margin-bottom: 0.25rem;
}

.scs-manager--conversation-body {
  margin: 0;
  overflow-wrap: break-word;
}

.scs-manager--conversation-body h3,
.scs-manager--conversation-body h4,
.scs-manager--conversation-body h5 {
  margin: 0 0 0.25rem;
}

.scs-manager--conversation-actions {
  display: flex;
  gap: 0.75rem;
  margin-top: 0.25rem;
}

.scs-manager--conversation-reply {
  margin-top: 1.5rem;
}
