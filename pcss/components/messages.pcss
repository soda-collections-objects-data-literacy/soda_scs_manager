/**
 * @file
 * In-app message inbox and detail.
 */

.scs-manager--conversation-start {
  @apply flex flex-col gap-4;
}

.scs-manager--conversation-start__chip {
  @apply inline-flex items-center gap-2 rounded-full bg-stone-100 px-3 py-1 text-sm text-stone-800;
}

.scs-manager--conversation-start__chip-remove {
  @apply inline-flex h-5 w-5 cursor-pointer items-center justify-center rounded-full border-0 bg-stone-300 p-0 text-base leading-none text-stone-800;

  &:hover,
  &:focus-visible {
    @apply bg-stone-400 outline outline-2 outline-offset-2 outline-orange-500;
  }
}

.scs-manager--conversation-team__new {
  @apply mb-4 inline-flex;
}

.scs-manager--conversation-team__filters {
  @apply mb-4;
}

.scs-manager--messages-row--unread {
  box-shadow: inset 0.25rem 0 0 #e68500;
}

.scs-manager--message-actions-row .button {
  @apply cursor-pointer;
}

.scs-manager--messages-conversation {
  @apply flex min-w-0 flex-col no-underline text-inherit;
}

.scs-manager--messages-preview {
  @apply truncate text-sm text-stone-500;
}

.scs-manager--conversation-back,
.scs-manager--conversation-participant {
  @apply mb-3;
}

.scs-manager--conversation-list {
  @apply m-0 flex list-none flex-col gap-4 p-0;
}

.scs-manager--conversation-message {
  @apply flex max-w-[48rem] items-end gap-2 self-start;
}

.scs-manager--conversation-message--own {
  @apply flex-row-reverse self-end;
}

.scs-manager--conversation-avatar {
  @apply flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-full bg-stone-200 text-sm font-semibold text-stone-700;

  & img {
    @apply h-full w-full object-cover;
  }
}

.scs-manager--conversation-bubble {
  @apply min-w-0 rounded-2xl rounded-bl-sm bg-stone-100 px-4 py-2 text-stone-900;
}

.scs-manager--conversation-message--own .scs-manager--conversation-bubble {
  @apply rounded-2xl rounded-br-sm bg-orange-100;
}

.scs-manager--conversation-message--deleted .scs-manager--conversation-bubble {
  @apply bg-transparent text-stone-500 ring-1 ring-stone-300;
}

.scs-manager--conversation-meta {
  @apply mb-1 flex flex-wrap items-baseline gap-2 text-xs text-stone-500;
}

.scs-manager--conversation-author {
  @apply font-semibold text-stone-700;
}

.scs-manager--conversation-body {
  @apply m-0 break-words;

  h3,
  h4,
  h5 {
    @apply m-0 mb-1 font-semibold text-stone-900;
  }

  h3 {
    @apply text-base;
  }

  h4 {
    @apply text-sm;
  }

  h5 {
    @apply text-sm font-medium;
  }

  a {
    @apply underline;
    color: rgb(198, 105, 0);

    &:hover {
      color: rgb(255, 138, 5);
    }
  }
}

.scs-manager--conversation-actions {
  @apply mt-1 flex gap-3 text-xs;
}

.scs-manager--conversation-reply {
  @apply mt-6;
}
