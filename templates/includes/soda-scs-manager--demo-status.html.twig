{#
/**
 * @file
 * Demo status of a user demo project (dashboard badge or project page panel).
 *
 * Busy demos are polled by js/demoProjectStatus.js through status_url. While
 * the job runs, the panel shows a shimmer and one step per application; the
 * script replaces the application cards as soon as an application exists and
 * reloads the page once the job has finished.
 *
 * Variables:
 * - variant: "badge" (dashboard card) or "panel" (project page).
 * - status: provisioning, resetting, ready or failed.
 * - status_label: Translated status.
 * - is_busy: Whether a job is running.
 * - message: Latest progress message while busy.
 * - apps: Rows of key, label and present while busy, otherwise empty.
 * - status_url: JSON status endpoint.
 * - reset_url: Reset confirmation URL; empty when the viewer cannot reset.
 * - current_version: Template version of this demo.
 * - newer_version: Active template version when newer than current_version.
 *
 * @ingroup themeable
 */
#}
{% set tone_classes = {
  'provisioning': 'bg-amber-100 text-amber-900',
  'resetting': 'bg-amber-100 text-amber-900',
  'ready': 'bg-emerald-100 text-emerald-900',
  'failed': 'bg-red-100 text-red-900',
} %}
{% set badge_classes = 'scs-manager--demo-status-badge inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-semibold ' ~ (tone_classes[status] ?? tone_classes.failed) %}

{% if variant == 'badge' %}
  <span class="{{ badge_classes }}" data-scs-demo-status data-status-url="{{ status_url }}" data-is-busy="{{ is_busy ? 'true' : 'false' }}">
    <span data-scs-demo-status-label>{{ status_label }}</span>
  </span>
{% elseif is_busy %}
  <section class="scs-manager--demo-status-panel project__section mb-4 flex flex-col gap-3 rounded-lg border border-gray-200 p-4" aria-live="polite" data-scs-demo-status data-status-url="{{ status_url }}" data-is-busy="true">
    <p class="m-0 text-sm font-medium text-gray-900" data-scs-demo-status-label>{{ status_label }}</p>
    <div class="h-2 w-full animate-pulse rounded-full bg-amber-100" aria-hidden="true"></div>
    {% if apps %}
      <div class="m-0 flex flex-wrap gap-3 text-xs" data-scs-demo-apps role="list" aria-label="{{ 'Setup progress'|t }}">
        {% for app in apps %}
          <span class="inline-flex items-center gap-1 {{ app.present ? 'text-emerald-900' : 'text-gray-400' }}" role="listitem" data-scs-demo-app="{{ app.key }}" data-present="{{ app.present ? 'true' : 'false' }}">
            <span class="inline-block h-2 w-2 shrink-0 rounded-full {{ app.present ? 'bg-emerald-500' : 'bg-gray-200' }}{{ app.current ? ' animate-pulse' : '' }}" data-scs-demo-app-dot aria-hidden="true"></span>
            {{ app.label }}
          </span>
        {% endfor %}
      </div>
    {% endif %}
    <p class="m-0 text-xs text-gray-500" data-scs-demo-status-message {% if not message %}hidden{% endif %}>{{ message }}</p>
  </section>
{% else %}
  <section class="scs-manager--demo-status-panel project__section mb-4 flex flex-col gap-2 rounded-lg border border-gray-200 p-4" aria-live="polite" data-scs-demo-status data-status-url="{{ status_url }}" data-is-busy="false">
    <div class="flex flex-wrap items-center gap-2">
      <span class="{{ badge_classes }}"><span data-scs-demo-status-label>{{ status_label }}</span></span>
      {% if current_version %}
        <span class="text-xs text-gray-600">{{ 'Version @version'|t({'@version': current_version}) }}</span>
      {% endif %}
    </div>
    {% if status == 'failed' %}
      <p class="m-0 text-sm text-gray-700">{{ 'Setting up the demo failed. Reset the demo to try again.'|t }}</p>
    {% endif %}
    {% if newer_version %}
      <p class="m-0 text-sm text-gray-700">{{ 'A newer demo version (v@version) is available. Reset the demo to use it.'|t({'@version': newer_version}) }}</p>
    {% endif %}
    {% if reset_url %}
      <div>
        <a class="btn btn--secondary scs-manager--demo-reset-link" href="{{ reset_url }}">{{ 'Reset demo'|t }}</a>
      </div>
    {% endif %}
  </section>
{% endif %}
