{#
/**
 * @file
 * Demo status of a user demo project (dashboard badge or project page panel).
 *
 * Busy demos are polled by js/demoProjectStatus.js through status_url. While
 * the job runs, the panel in the sidebar lists one line per application that
 * is not ready yet, with a spinning throbber beside its status. A line
 * disappears as soon as that application is ready.
 * The script rebuilds the application cards when an application appears and
 * again when it is ready, and reloads the page once the job has finished.
 *
 * Variables:
 * - variant: "badge" (dashboard card) or "panel" (project page).
 * - status: provisioning, resetting, ready or failed.
 * - status_label: Translated status.
 * - is_busy: Whether a job is running.
 * - message: Unused; kept for the theme variable.
 * - job_line: What the demo job does and since when (queued, running,
 *   waiting with the next attempt, or the reason it failed); may be empty.
 * - apps: Rows of key, label and detail for applications that are not ready.
 * - status_url: JSON status endpoint.
 * - reset_url: Reset confirmation URL; empty when the viewer cannot reset.
 * - current_version: Template version of this demo.
 * - newer_version: Active template version when newer than current_version.
 *
 * @ingroup themeable
 */
#}
{% if variant == 'badge' %}
  <span class="tag tag--demo" data-scs-demo-status data-status-url="{{ status_url }}" data-is-busy="{{ is_busy ? 'true' : 'false' }}"{% if job_line %} title="{{ job_line }}"{% endif %}>{{ status_label }}</span>
{% elseif is_busy %}
  <section class="scs-manager--demo-status-panel project__section" aria-live="polite" data-scs-demo-status data-status-url="{{ status_url }}" data-is-busy="true">
    <h2 class="project__section-title h5" data-scs-demo-status-label>{{ status_label }}</h2>
    <p class="scs-manager--demo-status-job-line" data-scs-demo-job-line{% if not job_line %} hidden{% endif %}>{{ job_line }}</p>
    <ul class="scs-manager--demo-status-apps" data-scs-demo-apps>
      {% for app in apps %}
        <li class="scs-manager--demo-status-app" data-scs-demo-app="{{ app.key }}">
          <span>{{ app.label }}</span>
          <span class="scs-manager--demo-status-app-state">
            <span class="scs-manager--demo-status-throbber" aria-hidden="true"></span>
            <span data-scs-demo-app-detail>{{ app.detail }}</span>
          </span>
        </li>
      {% endfor %}
    </ul>
  </section>
{% else %}
  <section class="scs-manager--demo-status-panel project__section" aria-live="polite" data-scs-demo-status data-status-url="{{ status_url }}" data-is-busy="false">
    <div class="project__section__header">
      <h2 class="project__section-title h5">{{ status == 'failed' ? status_label : 'Demo'|t }}</h2>
      {% if reset_url %}
        {{ attach_library('soda_scs_manager/demoResetOverlay') }}
        <div class="scs-manager--demo-reset">
          <a class="btn btn--secondary scs-manager--demo-reset-link" href="{{ reset_url }}" aria-haspopup="dialog">{{ 'Reset demo'|t }}</a>
          <div class="project-card__delete-confirmation project-card__delete-confirmation--grid scs-manager--demo-reset-dialog" role="dialog" aria-modal="true" aria-label="{{ 'Reset demo'|t }}" hidden>
            <div class="project-card__delete-confirmation__backdrop" aria-hidden="true"></div>
            <div class="project-card__delete-confirmation__dialog" role="document">
              <button type="button" class="btn btn--secondary btn--icon overlay__close scs-manager--demo-reset-close" aria-label="{{ 'Close'|t }}">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <line x1="14.8493" y1="14.8493" x2="4.94983" y2="4.94978" stroke="#17212B" stroke-width="2"/>
                  <line x1="4.94979" y1="14.8492" x2="14.8493" y2="4.94975" stroke="#17212B" stroke-width="2"/>
                </svg>
              </button>
              <h3>{{ 'Reset demo'|t }}</h3>
              <p class="scs-manager--demo-reset-loading" role="status">{{ 'Loading...'|t }}</p>
              <div class="scs-manager--demo-reset-content"></div>
              <div class="scs-manager--demo-reset-error" role="alert" hidden>
                <p>{{ 'The reset confirmation could not be loaded.'|t }}</p>
                <a class="btn btn--secondary" href="{{ reset_url }}">{{ 'Reset demo'|t }}</a>
              </div>
            </div>
          </div>
        </div>
      {% endif %}
    </div>
    {% if current_version %}
      <p class="scs-manager--demo-status-version">{{ 'Version @version'|t({'@version': current_version}) }}</p>
    {% endif %}
    {% if status == 'failed' %}
      {% if job_line %}
        <p class="scs-manager--demo-status-note">{{ job_line }}</p>
      {% endif %}
      <p class="scs-manager--demo-status-note">{{ 'Setting up the demo failed. Reset the demo to try again.'|t }}</p>
    {% endif %}
    {% if newer_version %}
      <p class="scs-manager--demo-status-note">{{ 'A newer demo version (v@version) is available. Reset the demo to use it.'|t({'@version': newer_version}) }}</p>
    {% endif %}
  </section>
{% endif %}
