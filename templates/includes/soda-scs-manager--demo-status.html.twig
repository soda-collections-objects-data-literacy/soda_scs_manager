{#
/**
 * @file
 * Demo status of a user demo project (dashboard badge or project page panel).
 *
 * Busy demos are polled by js/demoProjectStatus.js through status_url. While
 * the job runs, the panel in the sidebar lists one line per application that
 * is not ready yet, with a spinning throbber beside its status. A line
 * disappears as soon as that application is ready.
 * The script rebuilds the application cards when an application appears and
 * again when it is ready, and reloads the page once the job has finished.
 *
 * Variables:
 * - variant: "badge" (dashboard card) or "panel" (project page).
 * - status: provisioning, resetting, ready or failed.
 * - status_label: Translated status.
 * - is_busy: Whether a job is running.
 * - message: Unused; kept for the theme variable.
 * - apps: Rows of key, label and detail for applications that are not ready.
 * - status_url: JSON status endpoint.
 * - reset_url: Reset confirmation URL; empty when the viewer cannot reset.
 * - current_version: Template version of this demo.
 * - newer_version: Active template version when newer than current_version.
 *
 * @ingroup themeable
 */
#}
{% if variant == 'badge' %}
  <span class="tag tag--demo" data-scs-demo-status data-status-url="{{ status_url }}" data-is-busy="{{ is_busy ? 'true' : 'false' }}">{{ status_label }}</span>
{% elseif is_busy %}
  <section class="scs-manager--demo-status-panel project__section" aria-live="polite" data-scs-demo-status data-status-url="{{ status_url }}" data-is-busy="true">
    <h2 class="project__section-title h5" data-scs-demo-status-label>{{ status_label }}</h2>
    <ul class="m-0 flex list-none flex-col gap-2 p-0 text-sm" data-scs-demo-apps>
      {% for app in apps %}
        <li class="flex items-center justify-between gap-3" data-scs-demo-app="{{ app.key }}">
          <span>{{ app.label }}</span>
          <span class="inline-flex items-center gap-2 text-gray-500">
            <span class="scs-manager--demo-status-throbber" aria-hidden="true"></span>
            <span data-scs-demo-app-detail>{{ app.detail }}</span>
          </span>
        </li>
      {% endfor %}
    </ul>
  </section>
{% else %}
  <section class="scs-manager--demo-status-panel project__section" aria-live="polite" data-scs-demo-status data-status-url="{{ status_url }}" data-is-busy="false">
    <div class="project__section__header">
      <h2 class="project__section-title h5">{{ status == 'failed' ? status_label : 'Demo'|t }}</h2>
      {% if reset_url %}
        <a class="btn btn--secondary scs-manager--demo-reset-link" href="{{ reset_url }}">{{ 'Reset demo'|t }}</a>
      {% endif %}
    </div>
    {% if current_version %}
      <p class="m-0 text-sm text-gray-600">{{ 'Version @version'|t({'@version': current_version}) }}</p>
    {% endif %}
    {% if status == 'failed' %}
      <p class="m-0 mt-2 text-sm text-gray-700">{{ 'Setting up the demo failed. Reset the demo to try again.'|t }}</p>
    {% endif %}
    {% if newer_version %}
      <p class="m-0 mt-2 text-sm text-gray-700">{{ 'A newer demo version (v@version) is available. Reset the demo to use it.'|t({'@version': newer_version}) }}</p>
    {% endif %}
  </section>
{% endif %}
