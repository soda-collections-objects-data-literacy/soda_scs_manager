{{ entity_type|replace({'soda_scs_': ''}) }}

{% set health_status = health_status|default('unknown')|lower %}
{% if health_status not in ['running', 'stopped', 'problem', 'unknown'] %}
	{% set health_status = 'unknown' %}
{% endif %}
{% set health_labels = {
	'running': 'Running'|t,
	'stopped': 'Stopped'|t,
	'problem': 'Problem'|t,
	'unknown': 'Unknown'|t,
} %}
{% set health_label = health_labels[health_status] %}

{% if bundle_label == "JupyterHub Environment" %}
    {% set application_type = "jupyterhub" %}
	{% set application_icons = [] %}
    {% set card_type = "single" %}
    {% set application_description = "Data Enrichment" %}

{% elseif bundle_label == "Nextcloud Environment" %}
    {% set application_type = "nextcloud" %}

{% elseif bundle_label == "WebProtégé" %}
    {% set application_type = "webprotege" %}
	{% set application_icons = [directory ~ "/assets/img/protege.svg"] %}
    {% set card_type = "single" %}
    {% set application_description = "Ontology Management" %}

{% elseif bundle_label == "WissKI Environment" %}
    {% set application_type = "wisski" %}
	{% set application_icons = [directory ~ "/assets/img/onlyoffice.svg", directory ~ "/assets/img/openrefine.svg", directory ~ "/assets/img/diagramsnet.svg"] %}
    {% set card_type = "multiple" %}
    {% set application_description = "Data Management" %}

{% elseif bundle_label == "Database" %}
    {% set application_type = "db" %}
	{% set application_icons = [] %}
    {% set card_type = "single" %}
    {% set application_description = "Database" %}

{% else %}
    {% set application_type = "" %}
    {% set application_icons = [] %}
    {% set card_type = "single" %}
    {% set application_description = "" %}

{% endif %}

{% if application_type != "nextcloud" %}
<div class="application--card application--card--{{ card_type }}"{% if entity_id %} data-entity-id="{{ entity_id }}"{% endif %}{% if entity_type_id %} data-entity-type="{{ entity_type_id }}"{% endif %} data-health-status="{{ health_status }}">
	<div class="application__meta">
		<div class="application__health-status application__health-status--{{ health_status }}" data-health-status="{{ health_status }}" title="{{ health_label }}">
			<div class="application__health__icon" aria-hidden="true"></div>
			<p aria-label="{{ 'Health status: @status'|t({'@status': health_label}) }}">
				{{ health_label }}
			</p>
		</div>
		<div class="application__documentation">
			<a href="{{ learn_more_link }}" class="application__documentation-link" aria-label="{{ 'View documentation for @title'|t({'@title': title}) }}" title="{{ 'Documentation'|t }}"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><!--!Font Awesome Pro v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2026 Fonticons, Inc.--><path fill="#17212B" d="M320 205.3L320 514.6L320.5 514.4C375.1 491.7 433.7 480 492.8 480L512 480L512 160L492.8 160C450.6 160 408.7 168.4 369.7 184.6C352.9 191.6 336.3 198.5 320 205.3zM294.9 125.5L320 136L345.1 125.5C391.9 106 442.1 96 492.8 96L528 96C554.5 96 576 117.5 576 144L576 496C576 522.5 554.5 544 528 544L492.8 544C442.1 544 391.9 554 345.1 573.5L332.3 578.8C324.4 582.1 315.6 582.1 307.7 578.8L294.9 573.5C248.1 554 197.9 544 147.2 544L112 544C85.5 544 64 522.5 64 496L64 144C64 117.5 85.5 96 112 96L147.2 96C197.9 96 248.1 106 294.9 125.5z"/></svg></a>
		</div>
		<div class="application__details">
			{% if details_link %}
				<a href="{{ details_link }}" class="application__details-link btn btn--secondary" aria-label="{{ 'View details of @title'|t({'@title': title}) }}">{{ 'Details'|t }}</a>
			{% endif %}
		</div>
	</div>

	<a href="{{ url }}" class="application__core" aria-label="{{ 'Open @title'|t({'@title': title}) }}">
		<h2 class="application__title h1">{{ application_description }}</h2>
		<div class="application__icons-and-arrow">
			<div class="application__icons">
				{% if application_icons is defined %}
					{% for icon in application_icons %}
						<img src="{{ icon }}" alt="" class="application__icon">
					{% endfor %}
				{% endif %}
			</div>
			<div class="application__arrow">
				<svg width="34" height="34" viewbox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg">
					<circle cx="17" cy="17" r="16.5" stroke="#17212B"/>
					<path d="M24 11C24 10.4477 23.5523 10 23 10L14 10C13.4477 10 13 10.4477 13 11C13 11.5523 13.4477 12 14 12L22 12L22 20C22 20.5523 22.4477 21 23 21C23.5523 21 24 20.5523 24 20L24 11ZM11 23L11.7071 23.7071L23.7071 11.7071L23 11L22.2929 10.2929L10.2929 22.2929L11 23Z" fill="#17212B"/>
				</svg>
			</div>
		</div>
	</a>

	<div class="application__name">
		<h3 class="h4">{{ title }}</h3>
		<div class="application__type">
			{{ bundle_label }}
		</div>
	</div>


</div>
{% endif %}