{#
/**
 * @file
 * Shared modal for choosing application type (MariaDB, WissKI, Triplestore).
 *
 * Available variables:
 * - asset_base: Base URL for module images.
 * - popup_url_mariadb, popup_url_wisski, popup_url_open_gdb: localized app URLs.
 */
#}
{% set assetBase = asset_base|default('/modules/custom/soda_scs_manager/assets/images/') %}
<div id="add-app-popup" class="overlay overlay--large add-app-popup" role="dialog" aria-modal="true" aria-labelledby="add-app-popup-title" hidden>
  <div class="overlay__backdrop" aria-hidden="true"></div>
  <div class="overlay__dialog" role="document">
    <button type="button"
            class="btn btn--secondary btn--icon overlay__close"
            id="close-popup"
            aria-label="{{ 'Close popup'|t }}">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <line x1="14.8493" y1="14.8493" x2="4.94983" y2="4.94978" stroke="#17212B" stroke-width="2"/>
        <line x1="4.94979" y1="14.8492" x2="14.8493" y2="4.94975" stroke="#17212B" stroke-width="2"/>
      </svg>
    </button>

    <h2 id="add-app-popup-title" class="add-app-popup__title">{{ 'Select Application Type'|t }}</h2>

    <div class="add-app-popup__grid">
      {# Database Card #}
      <a href="{{ popup_url_mariadb }}"
         data-app-type="mariadb"
         class="add-app-popup-card">
        <div class="add-app-popup-card__icon-wrapper">
          <img src="{{ assetBase }}sql.svg" alt="" class="add-app-popup-card__icon" />
        </div>
        <h3 class="add-app-popup-card__title">{{ 'MariaDB Database'|t }}</h3>
        <p class="add-app-popup-card__text">{{ '+ more info'|t }}</p>
      </a>

      {# WissKI Card #}
      <a href="{{ popup_url_wisski }}"
         data-app-type="wisski"
         class="add-app-popup-card">
        <div class="add-app-popup-card__icon-wrapper">
          <img src="{{ assetBase }}wisski-stack.svg" alt="" class="add-app-popup-card__icon" />
        </div>
        <h3 class="add-app-popup-card__title">{{ 'WissKI Environment'|t }}</h3>
        <p class="add-app-popup-card__text">{{ '+ more info'|t }}</p>
      </a>

      {# Triplestore Card #}
      <a href="{{ popup_url_open_gdb }}"
         data-app-type="openGdb"
         class="add-app-popup-card">
        <div class="add-app-popup-card__icon-wrapper">
          <img src="{{ assetBase }}triplestore.svg" alt="" class="add-app-popup-card__icon" />
        </div>
        <h3 class="add-app-popup-card__title">{{ 'Triplestore (OpenGDB)'|t }}</h3>
        <p class="add-app-popup-card__text">{{ '+ more info'|t }}</p>
      </a>
    </div>
  </div>
</div>
