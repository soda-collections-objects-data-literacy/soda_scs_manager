{{ entity_type|replace({'soda_scs_': ''}) }}

{% set health_status = health_status|default('unknown')|lower %}
{% if health_status not in ['running', 'starting', 'stopped', 'problem', 'unknown'] %}
	{% set health_status = 'unknown' %}
{% endif %}
{% set health_labels = {
	'running': 'Running'|t,
	'starting': 'Starting'|t,
	'stopped': 'Stopped'|t,
	'problem': 'Problem'|t,
	'unknown': 'Unknown'|t,
} %}
{% set health_label = health_labels[health_status] %}
{% set type_titles = {
	'soda_scs_jupyter_stack': 'Data Enrichment'|t,
	'soda_scs_webprotege_component': 'Ontology Management'|t,
	'soda_scs_wisski_stack': 'Data Management'|t,
	'soda_scs_wisski_component': 'Data Management'|t,
	'soda_scs_sql_component': 'Database'|t,
} %}
{% set type_title = type_titles[bundle_id|default('')] ?? bundle_label ?? title %}

	<div class="application--card"{% if entity_id %} data-entity-id="{{ entity_id }}"{% endif %}{% if entity_type_id %} data-entity-type="{{ entity_type_id }}"{% endif %} data-health-status="{{ health_status }}">
		<div class="application__meta">
			<div class="application__health-status application__health-status--{{ health_status }}" data-health-status="{{ health_status }}" title="{{ health_label }}">
        <div class="application__health__icon" aria-hidden="true"></div>
				<p aria-label="{{ 'Health status: @status'|t({'@status': health_label}) }}">
					{{ health_label }}
				</p>
			</div>
		<div class="application__documentation">
			<a href="{{ learn_more_link }}" class="application__documentation-link" aria-label="{{ 'View documentation for @title'|t({'@title': title}) }}" title="{{ 'Documentation'|t }}">i</a>
		</div>
		{% if details_link %}
			<div class="application__details">
				<a href="{{ details_link }}" class="application__details-link" aria-label="{{ 'View details of @title'|t({'@title': title}) }}" title="{{ 'View details'|t }}"></a>
			</div>
		{% endif %}
	</div>

	<a href="{{ url }}" class="application__core" aria-label="{{ 'Open @title'|t({'@title': title}) }}">
		<h2 class="application__title h1">{{ type_title }}</h2>
		<div class="application__icons-and-arrow">
			<div class="application__icons">
				{% if icon %}
					<img src="{{ icon }}" alt="" class="application__icon">
				{% endif %}
			</div>
			<div class="application__arrow">
				<svg width="34" height="34" viewbox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg">
					<circle cx="17" cy="17" r="16.5" stroke="#17212B"/>
					<path d="M24 11C24 10.4477 23.5523 10 23 10L14 10C13.4477 10 13 10.4477 13 11C13 11.5523 13.4477 12 14 12L22 12L22 20C22 20.5523 22.4477 21 23 21C23.5523 21 24 20.5523 24 20L24 11ZM11 23L11.7071 23.7071L23.7071 11.7071L23 11L22.2929 10.2929L10.2929 22.2929L11 23Z" fill="#17212B"/>
				</svg>
			</div>
		</div>
	</a>

	<div class="application__title">
		<h3 class="h4">{{ title }}</h3>
		<div class="application__type">
			{{ bundle_label }}
		</div>
	</div>
</div>
