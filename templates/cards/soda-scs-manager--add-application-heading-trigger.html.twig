{#
/**
 * @file
 * Compact (+) control next to a project heading; opens add-app modal.
 *
 * Available variables:
 * - project_id: Project entity ID to assign new applications to.
 */
#}
<button type="button"
        class="soda-scs-manager--add-app-button soda-scs-manager--add-app-heading-button"
        data-project-id="{{ project_id }}"
        aria-label="{{ 'Add new application'|t }}"
        title="{{ 'Add new application'|t }}">
  <span aria-hidden="true" class="soda-scs-manager--add-app-heading-plus">+</span>
</button>
