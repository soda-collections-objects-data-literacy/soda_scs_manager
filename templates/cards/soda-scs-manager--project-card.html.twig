{#
/**
 * @file
 * Dashboard card for a project with contained application online/offline status.
 *
 * Available variables:
 * - project_id: Project entity ID.
 * - label: Project label.
 * - url: Canonical project URL.
 * - is_owner: Whether the current user owns the project.
 * - members_count: Number of project participants (owner + members).
 * - applications: List of application summaries (label, is_online, url, …).
 * - tags: Aggregated filter tags from contained applications.
 */
#}
{% set tags_hidden_from_ui = ['data-science', 'publishing'] %}
<a class="project--card project-card" href="{{ url }}">

	<div class="project-card__header">
    <div class="project-card__acronym">
      {{ label|slice(0, 1)|upper }}
    </div>
		<h2 class="project-card__title h6">
			{{ label }}
		</h2>
	</div>

	<div class="project-card__tags">
		{% for tag in tags|sort %}
			{% if tag not in tags_hidden_from_ui %}
				<span class="tag" data-tag="{{ tag }}">{{ tag|t }}</span>
			{% endif %}
		{% endfor %}
	</div>

  <div class="project-card__date">

  </div>

	<p class="project-card__members">
		{% if members_count == 1 %}
			{{ '1 member'|t }}
		{% else %}
			{{ '@count members'|t({'@count': members_count}) }}
		{% endif %}
	</p>

  <div class="project-card__edit">

  </div>

</a>
