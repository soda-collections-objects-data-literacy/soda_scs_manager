{#
/**
 * @file
 * Single in-app message with type-specific actions.
 *
 * Available variables:
 * - subject, sender, date: header fields.
 * - body: render array for the message body.
 * - actions: action form (accept/decline/delete, depending on type).
 * - inbox_url: URL back to the inbox.
 */
#}

<article class="scs-manager--message mx-auto max-w-3xl">
  <p class="mb-4">
    <a href="{{ inbox_url }}" class="text-stone-600 hover:text-stone-900 no-underline hover:underline">{{ 'Back to messages'|t }}</a>
  </p>
  <header class="border-b border-stone-200 pb-4 mb-6">
    <h1 class="text-xl font-semibold text-stone-800 m-0">{{ subject }}</h1>
    <dl class="mt-3 grid gap-1 text-sm text-stone-600 m-0">
      <div>
        <dt class="inline font-medium">{{ 'From'|t }}:</dt>
        <dd class="inline m-0">{{ sender }}</dd>
      </div>
      <div>
        <dt class="inline font-medium">{{ 'Date'|t }}:</dt>
        <dd class="inline m-0">{{ date }}</dd>
      </div>
    </dl>
  </header>
  <div class="scs-manager--message-body text-stone-700 mb-8">
    {{ body }}
  </div>
  {{ actions }}
</article>
