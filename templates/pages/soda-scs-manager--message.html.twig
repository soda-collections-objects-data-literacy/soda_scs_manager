{#
/**
 * @file
 * Single in-app message with type-specific actions.
 *
 * Available variables:
 * - subject, sender, date: header fields.
 * - body: render array for the message body.
 * - actions: action form (accept/decline/delete, depending on type).
 * - inbox_url: URL back to the inbox.
 */
#}

<article class="scs-manager--message">
  <p class="scs-manager--message-back">
    <a href="{{ inbox_url }}" class="scs-manager--message-back-link">{{ 'Back to messages'|t }}</a>
  </p>
  <header class="scs-manager--message-header">
    <h1 class="scs-manager--message-subject">{{ subject }}</h1>
    <dl class="scs-manager--message-meta">
      <div>
        <dt class="scs-manager--message-meta-label">{{ 'From'|t }}:</dt>
        <dd class="scs-manager--message-meta-value">{{ sender }}</dd>
      </div>
      <div>
        <dt class="scs-manager--message-meta-label">{{ 'Date'|t }}:</dt>
        <dd class="scs-manager--message-meta-value">{{ date }}</dd>
      </div>
    </dl>
  </header>
  <div class="scs-manager--message-body">
    {{ body }}
  </div>
  {{ actions }}
</article>
