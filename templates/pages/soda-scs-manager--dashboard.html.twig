{#
/**
 * @file
 * Default theme implementation for SODa SCS Manager dashboard page.
 *
 * Available variables:
 * - attributes: HTML attributes for the container.
 * - project_cards: Project cards with application online/offline summaries.
 * - intro_coworking_wizard: First-login intro carousel (boolean).
 * - intro_asset_base: Base URL for module SVGs (e.g. /modules/custom/soda_scs_manager/assets/images/).
 * - intro_connected_accounts_url: URL for Connected Accounts (Nextcloud hint).
 * - intro_gif_src, intro_mp4_src: Welcome-slide media when the wizard is shown (MP4 preferred).
 * @ingroup themeable
 */
#}

{% if intro_coworking_wizard %}
	{% include '@soda_scs_manager/includes/soda-scs-manager--coworking-intro.html.twig' %}
{% endif %}

<div class="dashboard__actions">
	<div class="dashboard__actions--search">
		<input type="text" class="dashboard__search" placeholder="{{ 'Search projects'|t }}" aria-label="{{ 'Search projects'|t }}">
	</div>
	<button type="button" class="btn button--primary soda-scs-manager--create-project-trigger" aria-controls="create-project-wizard" aria-expanded="false">
		<div class="btn__icon">
			<svg width="12" height="12" viewbox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
				<line x1="6" y1="-4.37114e-08" x2="6" y2="12" stroke="#FFA933" stroke-width="2"/>
				<line x1="12" y1="6" y2="6" stroke="#FFA933" stroke-width="2"/>
			</svg>
		</div>
		<p>{{ 'Create project'|t }}</p>
	</button>
</div>

{% if project_cards is not empty %}
	<div class="dashboard__projects">
		{% for card in project_cards %}
			{{ card }}
		{% endfor %}
	</div>
{% else %}
	<div class="dashboard__projects dashboard__projects--empty">
		<p>{{ 'No projects found.'|t }}</p>
	</div>
{% endif %}
