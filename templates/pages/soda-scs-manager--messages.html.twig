{#
/**
 * @file
 * Inbox list of in-app messages.
 *
 * Available variables:
 * - messages: list of {id, is_unread, sender, subject, date, url, actions}.
 */
#}

<div class="scs-manager--messages">
  {% if messages is empty %}
    <p class="scs-manager--messages-empty">{{ 'You have no messages.'|t }}</p>
  {% else %}
    <ul class="scs-manager--messages-list">
      {% for item in messages %}
        <li class="scs-manager--messages-row{{ item.is_unread ? ' scs-manager--messages-row--unread' : '' }}">
          <div class="scs-manager--messages-item">
            <span class="scs-manager--messages-sender" title="{{ item.sender }}" aria-label="{{ item.sender }}">
              {% if item.sender_picture %}
                {{ item.sender_picture }}
              {% else %}
                <span class="scs-manager--messages-initials" aria-hidden="true">{{ item.sender_initials }}</span>
              {% endif %}
            </span>
            <span class="scs-manager--messages-subject">{{ item.subject }}</span>
            <time class="scs-manager--messages-date">{{ item.date }}</time>
            <div class="scs-manager--messages-actions">{{ item.actions }}</div>
          </div>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>
