{#
/**
 * @file
 * Profile page of the current user.
 *
 * Available variables:
 * - name: Display name.
 * - initials: Initials shown when there is no picture.
 * - picture: Rendered profile picture or NULL.
 * - picture_form, info_form, security_form, language_form: Forms.
 * - can_delete: Whether the profile may be deleted.
 * - delete_url: Confirmation form URL for deleting the profile.
 * - delete_destination: Where to go after the profile is deleted.
 */
#}

<div class="profile--header">
  <div class="profile__picture">
    {% if picture %}
      <div class="profile__picture-image">{{ picture }}</div>
    {% else %}
      <span class="profile__picture-initials" aria-hidden="true">{{ initials }}</span>
    {% endif %}
    <button type="button" class="profile__picture-edit-button btn btn--secondary project-note-edit-trigger" aria-controls="profile-picture-edit" aria-expanded="false"><svg width="14" height="13" viewBox="0 0 14 13" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M1 11.5H13V9.5H14V12.5H0V9.5H1V11.5Z" fill="#17212B"/><path d="M7.35355 0.146446C7.15829 -0.0488157 6.84171 -0.0488157 6.64645 0.146446L3.46447 3.32843C3.2692 3.52369 3.2692 3.84027 3.46447 4.03553C3.65973 4.2308 3.97631 4.2308 4.17157 4.03553L7 1.20711L9.82843 4.03553C10.0237 4.2308 10.3403 4.2308 10.5355 4.03553C10.7308 3.84027 10.7308 3.52369 10.5355 3.32843L7.35355 0.146446ZM7 8.5H7.5V0.5H7H6.5L6.5 8.5H7Z" fill="#17212B"/></svg>{{ 'Upload picture'|t }}</button>
    <div id="profile-picture-edit" class="overlay overlay--small project-note-edit-overlay" role="dialog" aria-modal="true" aria-labelledby="profile-picture-edit-title" hidden>
      <div class="overlay__backdrop" aria-hidden="true"></div>
      <div class="overlay__dialog" role="document">
        <button type="button" class="btn btn--secondary btn--icon overlay__close project-note-edit-overlay__close" aria-label="{{ 'Close'|t }}">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <line x1="14.8493" y1="14.8493" x2="4.94983" y2="4.94978" stroke="#17212B" stroke-width="2"/>
            <line x1="4.94979" y1="14.8492" x2="14.8493" y2="4.94975" stroke="#17212B" stroke-width="2"/>
          </svg>
        </button>
        <h2 id="profile-picture-edit-title">{{ 'Upload picture'|t }}</h2>
        {{ picture_form }}
      </div>
    </div>
  </div>
</div>

<div class="profile--left">
  <section class="application__details-card profile__card profile__card--infos">
    <h2 class="application__details-card-title h4">{{ 'Infos'|t }}</h2>
    {{ info_form }}
  </section>
</div>

<div class="profile--right">
  <section class="application__details-card profile__card profile__card--security">
    <h2 class="application__details-card-title h4">{{ 'Security'|t }}</h2>
    {{ security_form }}
  </section>

  <section class="application__details-card profile__card profile__card--language">
    <h2 class="application__details-card-title h4">{{ 'Language'|t }}</h2>
    {{ language_form }}
  </section>

  {% if can_delete %}
    <div class="application__details-delete">
      <button type="button" class="application__details-delete-trigger btn" data-delete-destination="{{ delete_destination }}" aria-controls="profile-delete-confirmation" aria-expanded="false">
        {{ 'Delete profile'|t }}
      </button>
      <div id="profile-delete-confirmation" class="application__details-delete-confirmation application__details-delete-confirmation--grid" role="dialog" aria-modal="true" aria-labelledby="profile-delete-title" hidden>
        <div class="application__details-delete-confirmation__backdrop" aria-hidden="true"></div>
        <div class="application__details-delete-confirmation__dialog" role="document">
          <h3 id="profile-delete-title">{{ 'Delete profile?'|t }}</h3>
          <p>{{ 'Do you really want to delete your profile? This action cannot be undone.'|t }}</p>
          <div class="application__details-delete-confirmation__actions">
            <button type="button" class="btn btn--secondary application__details-delete-confirmation__cancel">{{ 'Cancel'|t }}</button>
            <a class="btn btn--primary application__details-delete-confirmation__confirm" data-delete-destination="{{ delete_destination }}" data-throbber-message="{{ 'Deleting the profile. Please do not close this window.'|t }}" href="{{ delete_url }}">{{ 'Delete profile'|t }}</a>
          </div>
        </div>
      </div>
    </div>
  {% endif %}
</div>
