{#
/**
 * @file
 * Project Team Folder recent activity (Files section / placeable block).
 *
 * Variables:
 * - status: connected|needs_connect
 * - open_url: Nextcloud URL into this project's Team Folder
 * - activities: { status, items: [{label, subtitle, url, action}] }
 * - project_label: Project display name
 */
#}
<div class="project__files project__section project__files__block" aria-label="{{ 'Project files'|t }}">
  <div class="project__section__header">
  		<h2 class="project__section-title h5">{{ 'Files'|t }}</h2>
	{% if open_url %}
		<a href="{{ open_url }}" target="_blank" rel="noopener noreferrer" class="project__files__button btn btn--extern btn--secondary">
			{{ 'Go to file system'|t }}
		</a>
	{% endif %}
  </div>

	{% if status == 'needs_connect' %}
		<div class="project__files__feed--needs-connect" data-reload-on-connect="1">
			<p class="text--notification">{{ 'Connect your Drive account to see recent activity in this project folder.'|t }}</p>
			<button type="button" class="project__files__connect">
				{{ 'Connect Drive'|t }}
			</button>
			<p data-status="unknown">{{ 'Checking connection…'|t }}</p>
			<div class="project__files__feed__connect-modal" aria-hidden="true" role="dialog" aria-labelledby="project-files-connect-title">
					<h3 class="h5">{{ 'Nextcloud connection'|t }}</h3>
					<div class="project__files__feed__connect-modal__actions">
						<button type="button" class="project__files__connect">
							{{ 'Connect'|t }}
						</button>
						<button type="button" class="project__files__connect">
							{{ 'Close'|t }}
						</button>
					</div>
			</div>
		</div>


	{% else %}
		<div class="project__files__feed">
			{% if activities.status == 'error' %}
				<p>{{ 'Project files could not be loaded.'|t }}</p>
			{% elseif activities.status == 'empty' or activities.items is empty %}
				<p>{{ 'No recent activity in this project folder.'|t }}</p>
			{% else %}
				<ul class="project__files__feed__files">
					{% for item in activities.items %}
						<li class="project-file">
								{% if item.url %}
									<a href="{{ item.url }}" target="_blank" rel="noopener noreferrer" title="{{ item.label }}">{{ item.label }}</a>
								{% else %}
									<span title="{{ item.label }}">{{ item.label }}</span>
								{% endif %}
								{% if item.subtitle %}
									<span title="{{ item.subtitle }}" class="file-date"> | {{ item.subtitle }}</span>
								{% endif %}
						</li>
					{% endfor %}
				</ul>
			{% endif %}
		</div>
	{% endif %}
</div>
