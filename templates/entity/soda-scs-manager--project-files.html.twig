{#
/**
 * @file
 * Project Team Folder recent activity (Files section / placeable block).
 *
 * Variables:
 * - status: connected|needs_connect
 * - open_url: Nextcloud URL into this project's Team Folder
 * - activities: { status, items: [{label, subtitle, url, action}] }
 * - project_label: Project display name
 */
#}
<div class="scs-manager--project-files flex flex-col gap-3" aria-label="{{ 'Project folder activity'|t }}">
  {% if open_url %}
    <a
      href="{{ open_url }}"
      target="_blank"
      rel="noopener noreferrer"
      class="scs-manager--project-files-open inline-flex w-fit items-center justify-center rounded border border-gray-300 px-3 py-1.5 text-sm font-medium hover:bg-gray-50"
    >
      {{ 'Open project folder'|t }}
    </a>
  {% endif %}

  {% if status == 'needs_connect' %}
    <div class="scs-manager--nextcloud-connect-wrapper scs-manager--nextcloud-connect-inline scs-manager--project-files-connect flex flex-col gap-2 rounded border border-dashed border-gray-300 p-3" data-reload-on-connect="1">
      <p class="text-sm">{{ 'Connect your Drive account to see recent activity in this project folder.'|t }}</p>
      <button type="button" class="scs-manager--nextcloud-connect-btn inline-flex w-fit items-center justify-center rounded bg-blue-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-blue-700">
        {{ 'Connect Drive'|t }}
      </button>
      <p class="scs-manager--nextcloud-connect-status-inline text-sm text-gray-600" data-status="unknown">{{ 'Checking connection…'|t }}</p>
      <div class="scs-manager--nextcloud-connect-modal hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50" aria-hidden="true" role="dialog" aria-labelledby="project-files-connect-title">
        <div class="scs-manager--nextcloud-connect-modal-content rounded-lg bg-white p-6 shadow-xl max-w-md mx-4">
          <h2 id="project-files-connect-title" class="mb-4 text-xl font-semibold">{{ 'Nextcloud connection'|t }}</h2>
          <p class="scs-manager--nextcloud-connect-status mb-2 hidden text-sm"></p>
          <p class="scs-manager--nextcloud-connect-error mb-2 hidden text-sm text-red-600"></p>
          <div class="flex gap-2">
            <button type="button" class="scs-manager--nextcloud-connect-btn rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700">
              {{ 'Connect'|t }}
            </button>
            <button type="button" class="scs-manager--nextcloud-connect-dismiss rounded border px-4 py-2 hover:bg-gray-100">
              {{ 'Close'|t }}
            </button>
          </div>
        </div>
      </div>
    </div>
  {% else %}
    <div class="scs-manager--project-files-feed flex flex-col gap-2">
      <p class="scs-manager--project-files-heading text-sm font-semibold uppercase tracking-wide text-gray-700">{{ 'Recent activity'|t }}</p>
      {% if activities.status == 'error' %}
        <p class="text-sm text-red-600">{{ 'Project folder activity could not be loaded.'|t }}</p>
      {% elseif activities.status == 'empty' or activities.items is empty %}
        <p class="text-sm text-gray-500">{{ 'No recent activity in this project folder.'|t }}</p>
      {% else %}
        <ul class="soda-scs-manager--card-feed-list scs-manager--project-files-list flex flex-col gap-2">
          {% for item in activities.items %}
            {% set action_labels = {
              'created': 'Created'|t,
              'changed': 'Edited'|t,
              'deleted': 'Deleted'|t,
              'restored': 'Restored'|t,
              'renamed': 'Renamed'|t,
              'moved': 'Moved'|t
            } %}
            {% set action = item.action|default('changed') %}
            {% if action not in action_labels|keys %}
              {% set action = 'changed' %}
            {% endif %}
            {% set action_label = action_labels[action] %}
            <li class="soda-scs-manager--card-feed-item scs-manager--project-files-item min-w-0">
              <span class="soda-scs-manager--card-feed-action soda-scs-manager--card-feed-action--{{ action }}"
                    aria-label="{{ action_label }}"
                    title="{{ action_label }}"></span>
              <span class="soda-scs-manager--card-feed-item-text">
                {% if item.url %}
                  <a
                    href="{{ item.url }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="soda-scs-manager--card-feed-link"
                    title="{{ item.label }}"
                  >{{ item.label }}</a>
                {% else %}
                  <span class="soda-scs-manager--card-feed-label" title="{{ item.label }}">{{ item.label }}</span>
                {% endif %}
                {% if item.subtitle %}
                  <span class="soda-scs-manager--card-feed-subtitle" title="{{ item.subtitle }}">{{ item.subtitle }}</span>
                {% endif %}
              </span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  {% endif %}
</div>
