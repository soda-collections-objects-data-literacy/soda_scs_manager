{#
/**
 * @file
 * Members list on the SODa SCS Project entity view.
 *
 * Available variables:
 * - members: List of { id, first_name, last_name, name, initials, username, mail, picture, is_current_user, remove_url, remove_form, remove_label, can_manage_roles, roles, roles_label }.
 *   roles lists { component_id, label, type, role, options, url } per application
 *   whose member role can be set; can_manage_roles is TRUE for owners and
 *   admins, who see the role menu even when no such application exists.
 * - owner: Owner profile with the same keys (no remove_url/remove_label).
 * - can_add_members: Whether the current user may invite members.
 * - add_form: Invite form (owners and admins).
 * - invitations: Pending and declined invitations for the edit overlay.
 *   Each item has the member profile keys plus status, status_label, and
 *   withdraw_form or resend_form and delete_form.
 *
 * @ingroup themeable
 */
#}
<div class="project__section__header">
	<h2 class="project__section-title h5">{{ 'Team'|t }}</h2>
	<button type="button" class="project__section__edit-button btn--secondary btn--icon project-members-edit-trigger" aria-controls="project-members-edit-overlay" aria-expanded="false" aria-label="{{ 'Edit team members'|t }}">
		<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16">
			<g><path fill="#4D5866" d="M14.545 3.042l-1.586-1.585c-.389-.389-1.025-.389-1.414 0l-1.293 1.293 3 3 1.293-1.293c.389-.389.389-1.026 0-1.415z"/><rect fill="#4D5866" x="5.129" y="3.8" transform="matrix(-.707 -.707 .707 -.707 6.189 20.064)" width="4.243" height="9.899"/><path fill="#4D5866" d="M.908 14.775c-.087.262.055.397.316.312l2.001-.667-1.65-1.646-.667 2.001z"/></g>
		</svg>
	</button>
</div>
<ul class="project__members__list">
	{% if owner is not empty %}
		<li class="project-member project-member--owner" title="{{ owner.username }}">
			{% if owner.picture %}
				{{ owner.picture }}
			{% else %}
				<span class="project-member__initials" aria-hidden="true">{{ owner.initials }}</span>
			{% endif %}
			<div class="project-member__info">
				<p class="project-member__name">{{ owner.name }}
					({{ 'Owner'|t }})</p>
				<p class="project-member__mail">{{ owner.mail }}</p>
			</div>
		</li>
	{% endif %}
	{% if members is not empty %}
		{% for member in members %}
			<li class="project-member{% if member.is_current_user %} project-member--current{% endif %}" title="{{ member.username }}">
				{% if member.picture %}
					{{ member.picture }}
				{% else %}
					<span class="project-member__initials" aria-hidden="true">{{ member.initials }}</span>
				{% endif %}
				<div class="project-member__info">
					<p class="project-member__name">{{ member.name }}</p>
					<p class="project-member__mail">{{ member.mail }}</p>
				</div>
			</li>
		{% endfor %}
	{% else %}
		<li class="field__item">{{ 'No members'|t }}</li>
	{% endif %}
</ul>

<div id="project-members-edit-overlay" class="overlay overlay--small project-members-edit-overlay" role="dialog" aria-modal="true" aria-labelledby="project-members-edit-title" hidden>
	<div class="overlay__backdrop" aria-hidden="true"></div>
	<div class="overlay__dialog" role="document">
		<button type="button" class="btn btn--secondary btn--icon overlay__close project-members-edit-overlay__close" aria-label="{{ 'Close'|t }}">
			<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
				<line x1="14.8493" y1="14.8493" x2="4.94983" y2="4.94978" stroke="#17212B" stroke-width="2"/>
				<line x1="4.94979" y1="14.8492" x2="14.8493" y2="4.94975" stroke="#17212B" stroke-width="2"/>
			</svg>
		</button>
		<h2 id="project-members-edit-title">{{ 'Edit team members'|t }}</h2>
		<ul class="project__members__list project__members__list--edit">
			{% if owner is not empty %}
				<li class="project-member project-member--owner" title="{{ owner.username }}">
					{% if owner.picture %}
						{{ owner.picture }}
					{% else %}
						<span class="project-member__initials" aria-hidden="true">{{ owner.initials }}</span>
					{% endif %}
					<div class="project-member__info">
						<p class="project-member__name">{{ owner.name }} ({{ 'Owner'|t }})</p>
						<p class="project-member__mail">{{ owner.mail }}</p>
					</div>
				</li>
			{% endif %}
			{% for member in members %}
				<li class="project-member{% if member.is_current_user %} project-member--current{% endif %}" title="{{ member.username }}">
					{% if member.picture %}
						{{ member.picture }}
					{% else %}
						<span class="project-member__initials" aria-hidden="true">{{ member.initials }}</span>
					{% endif %}
					<div class="project-member__info">
						<p class="project-member__name">{{ member.name }}</p>
						<p class="project-member__mail">{{ member.mail }}</p>
					</div>
					<div class="project-member__actions">
					{% if member.can_manage_roles %}
						<div class="project-member__roles-menu">
							<button type="button" class="project-member__roles-trigger btn btn--secondary btn--icon" aria-label="{{ member.roles_label }}" title="{{ member.roles_label }}" aria-expanded="false">
								<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path d="M10 2L3.5 4.5v4.8c0 4 2.8 7.4 6.5 8.7 3.7-1.3 6.5-4.7 6.5-8.7V4.5L10 2z" stroke="#17212B" stroke-width="1.6" stroke-linejoin="round"/>
									<circle cx="10" cy="8.5" r="2" stroke="#17212B" stroke-width="1.6"/>
									<path d="M6.8 13.6c.7-1.4 1.9-2.1 3.2-2.1s2.5.7 3.2 2.1" stroke="#17212B" stroke-width="1.6" stroke-linecap="round"/>
								</svg>
							</button>
							<div class="project-member__roles-panel" hidden>
								<p class="project-member__roles-title">{{ 'Roles per application'|t }}</p>
								{% if member.roles is empty %}
									<p class="project-member__roles-empty">{{ 'This project has no application with roles yet. Roles can currently be set for WissKI instances.'|t }}</p>
								{% endif %}
								<ul class="project-member__roles-list">
									{% for row in member.roles %}
										{% set select_id = 'project-member-role-' ~ member.id ~ '-' ~ row.component_id %}
										<li class="project-member__role">
											<label class="project-member__role-label" for="{{ select_id }}">
												<span class="project-member__role-name">{{ row.label }}</span>
												<span class="project-member__role-type">{{ row.type }}</span>
											</label>
											<select id="{{ select_id }}" class="project-member__role-select form-select" data-role-url="{{ row.url }}" data-current-role="{{ row.role }}">
												{% for value, option_label in row.options %}
													<option value="{{ value }}"{% if value == row.role %} selected{% endif %}>{{ option_label }}</option>
												{% endfor %}
											</select>
										</li>
									{% endfor %}
								</ul>
								<p class="project-member__roles-status" role="status" aria-live="polite"></p>
							</div>
						</div>
					{% endif %}
					{% if member.remove_form %}
						<div class="project-member__remove-menu">
							<button type="button" class="project-member__remove-trigger btn btn--secondary btn--icon" aria-label="{{ member.remove_label }}" title="{{ member.remove_label }}" aria-expanded="false">
								<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
									<line x1="14.8493" y1="14.8493" x2="4.94983" y2="4.94978" stroke="#17212B" stroke-width="2"/>
									<line x1="4.94979" y1="14.8492" x2="14.8493" y2="4.94975" stroke="#17212B" stroke-width="2"/>
								</svg>
							</button>
							<div class="project-member__remove-confirm" hidden>
								{{ member.remove_form }}
							</div>
						</div>
					{% endif %}
					</div>
				</li>
			{% endfor %}
		</ul>
		{% if invitations is not empty %}
			<h3 class="project__members__invitations-title h5">{{ 'Pending invitations'|t }}</h3>
			<ul class="project__members__list project__members__list--edit project__members__list--invitations">
				{% for invitation in invitations %}
					<li class="project-member project-member--invitation{% if invitation.status == 'rejected' %} project-member--invitation-declined{% endif %}">
						{% if invitation.picture %}
							{{ invitation.picture }}
						{% else %}
							<span class="project-member__initials" aria-hidden="true">{{ invitation.initials }}</span>
						{% endif %}
						<div class="project-member__info">
							<p class="project-member__name">{{ invitation.name }}</p>
							<p class="project-member__mail">{{ invitation.mail }}</p>
							<p class="project-member__status">{{ invitation.status_label }}</p>
						</div>
						<div class="project-member__invitation-actions">
							{% if invitation.resend_form %}
								{{ invitation.resend_form }}
							{% endif %}
							{% if invitation.withdraw_form %}
								<div class="project-member__remove-menu">
									<button type="button" class="project-member__remove-trigger btn btn--secondary btn--icon" aria-label="{{ invitation.withdraw_label }}" title="{{ invitation.withdraw_label }}" aria-expanded="false">
										<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
											<line x1="14.8493" y1="14.8493" x2="4.94983" y2="4.94978" stroke="#17212B" stroke-width="2"/>
											<line x1="4.94979" y1="14.8492" x2="14.8493" y2="4.94975" stroke="#17212B" stroke-width="2"/>
										</svg>
									</button>
									<div class="project-member__remove-confirm" hidden>
										{{ invitation.withdraw_form }}
									</div>
								</div>
							{% endif %}
							{% if invitation.delete_form %}
								<div class="project-member__remove-menu">
									<button type="button" class="project-member__remove-trigger btn btn--secondary btn--icon" aria-label="{{ invitation.delete_label }}" title="{{ invitation.delete_label }}" aria-expanded="false">
										<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
											<line x1="14.8493" y1="14.8493" x2="4.94983" y2="4.94978" stroke="#17212B" stroke-width="2"/>
											<line x1="4.94979" y1="14.8492" x2="14.8493" y2="4.94975" stroke="#17212B" stroke-width="2"/>
										</svg>
									</button>
									<div class="project-member__remove-confirm" hidden>
										{{ invitation.delete_form }}
									</div>
								</div>
							{% endif %}
						</div>
					</li>
				{% endfor %}
			</ul>
		{% endif %}
		<div class="project__members__edit">
			{% if can_add_members %}
				<div id="soda-scs-manager-add-member-form" class="project-members-edit-overlay__add-member-form">
					{{ add_form }}
				</div>
			{% endif %}
		</div>
	</div>
</div>
